# ERMS frontend — nginx server config (rendered by the image's envsubst entrypoint).
#
# Rendered from /etc/nginx/templates/default.conf.template into /tmp/default.conf at container
# start (NGINX_ENVSUBST_OUTPUT_DIR=/tmp, so only /tmp has to be writable). Only variables that are
# set in the environment are substituted (BACKEND_URL); nginx runtime variables such as $uri are
# left untouched. Included inside the `http {}` block of nginx/nginx.conf.

# Long-lived caching for content-hashed assets, revalidation for everything else (index.html).
# API responses keep whatever Cache-Control the backend sends (empty value = header not added).
map $uri $erms_cache_control {
    ~^/assets/  "public, max-age=31536000, immutable";
    ~^/api/     "";
    default     "no-cache";
}

server {
    # IPv4 only: an IPv6 listener fails to start on hosts/pods with IPv6 disabled.
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    server_tokens off;
    client_max_body_size 1m;

    gzip on;
    gzip_vary on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml application/problem+json;

    # Security headers (docs/SECURITY.md). Declared once at server level and inherited by every
    # location, because no location below defines its own add_header.
    add_header Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "geolocation=(), camera=(), microphone=()" always;
    add_header Cache-Control $erms_cache_control always;

    # Liveness/readiness for Docker HEALTHCHECK and Kubernetes probes.
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Same-origin API: used by docker-compose. On Kubernetes the Ingress routes /api to the backend
    # directly, so this block is only a fallback there. The full URI (/api/v1/...) is forwarded.
    location /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Request-Id $erms_request_id;  # map in nginx.conf
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
        # nginx's own security headers above apply; drop the backend's duplicates.
        proxy_hide_header X-Frame-Options;
        proxy_hide_header X-Content-Type-Options;
        proxy_hide_header Referrer-Policy;
        proxy_hide_header Content-Security-Policy;
        proxy_hide_header Permissions-Policy;
    }

    # Content-hashed build output: must exist, never fall back to index.html.
    location /assets/ {
        try_files $uri =404;
    }

    # Never serve dotfiles.
    location ~ /\. {
        return 404;
    }

    # SPA fallback: deep links such as /resource-status serve index.html.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
