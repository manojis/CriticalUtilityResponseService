{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "ERMS chart values",
  "type": "object",
  "definitions": {
    "image": {
      "type": "object",
      "required": [
        "repository",
        "pullPolicy"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": [
            "string",
            "integer"
          ],
          "description": "Image tag (git sha). Integers are accepted because --set parses all-digit shas as numbers."
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      },
      "additionalProperties": false
    },
    "resources": {
      "type": "object",
      "properties": {
        "requests": {
          "type": "object"
        },
        "limits": {
          "type": "object"
        }
      }
    },
    "autoscaling": {
      "type": "object",
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minReplicas": {
          "type": "integer",
          "minimum": 1
        },
        "maxReplicas": {
          "type": "integer",
          "minimum": 1
        },
        "targetCPUUtilizationPercentage": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      },
      "additionalProperties": false
    },
    "pdb": {
      "type": "object",
      "properties": {
        "minAvailable": {
          "type": [
            "integer",
            "string"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "imageRegistry",
    "backend",
    "frontend",
    "mysql",
    "secrets",
    "ingress",
    "networkPolicy"
  ],
  "properties": {
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "imageRegistry": {
      "type": "string"
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "backend": {
      "type": "object",
      "required": [
        "image",
        "replicas",
        "resources"
      ],
      "properties": {
        "image": {
          "$ref": "#/definitions/image"
        },
        "replicas": {
          "type": "integer",
          "minimum": 0
        },
        "profiles": {
          "type": "string"
        },
        "apiDocsEnabled": {
          "type": "boolean"
        },
        "corsAllowedOrigins": {
          "type": "string"
        },
        "jwt": {
          "type": "object",
          "properties": {
            "ttl": {
              "type": "string",
              "pattern": "^P"
            },
            "issuer": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "timeZone": {
          "type": "string",
          "minLength": 1
        },
        "datasource": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string"
            },
            "username": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "extraEnv": {
          "type": "array"
        },
        "podAnnotations": {
          "type": "object"
        },
        "resources": {
          "$ref": "#/definitions/resources"
        },
        "autoscaling": {
          "$ref": "#/definitions/autoscaling"
        },
        "pdb": {
          "$ref": "#/definitions/pdb"
        },
        "nodeSelector": {
          "type": "object"
        },
        "tolerations": {
          "type": "array"
        },
        "affinity": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "frontend": {
      "type": "object",
      "required": [
        "image",
        "replicas",
        "resources"
      ],
      "properties": {
        "image": {
          "$ref": "#/definitions/image"
        },
        "replicas": {
          "type": "integer",
          "minimum": 0
        },
        "podAnnotations": {
          "type": "object"
        },
        "resources": {
          "$ref": "#/definitions/resources"
        },
        "autoscaling": {
          "$ref": "#/definitions/autoscaling"
        },
        "pdb": {
          "$ref": "#/definitions/pdb"
        },
        "nodeSelector": {
          "type": "object"
        },
        "tolerations": {
          "type": "array"
        },
        "affinity": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "mysql": {
      "type": "object",
      "required": [
        "enabled",
        "image",
        "database",
        "username",
        "storage"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "$ref": "#/definitions/image"
        },
        "database": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_]+$"
        },
        "username": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_]+$"
        },
        "readOnlyRootFilesystem": {
          "type": "boolean"
        },
        "storage": {
          "type": "object",
          "required": [
            "size"
          ],
          "properties": {
            "size": {
              "type": "string",
              "pattern": "^[0-9]+(Mi|Gi|Ti)$"
            },
            "storageClass": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "resources": {
          "$ref": "#/definitions/resources"
        },
        "nodeSelector": {
          "type": "object"
        },
        "tolerations": {
          "type": "array"
        },
        "affinity": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "waitForDb": {
      "type": "object",
      "properties": {
        "image": {
          "$ref": "#/definitions/image"
        }
      },
      "additionalProperties": false
    },
    "secrets": {
      "type": "object",
      "properties": {
        "existingSecret": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "ingress": {
      "type": "object",
      "required": [
        "enabled",
        "host"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string"
        },
        "host": {
          "type": "string",
          "minLength": 1
        },
        "annotations": {
          "type": "object"
        },
        "tls": {
          "type": "array"
        }
      },
      "additionalProperties": false
    },
    "networkPolicy": {
      "type": "object",
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "ingressControllerNamespace": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "tests": {
      "type": "object",
      "properties": {
        "image": {
          "$ref": "#/definitions/image"
        }
      },
      "additionalProperties": false
    }
  }
}
