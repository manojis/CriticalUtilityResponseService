# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.java]
# google-java-format (Spotless) is authoritative for Java.
indent_size = 2
max_line_length = 100

[*.{xml,sql}]
indent_size = 4

[*.{sh,bash}]
indent_size = 2
shell_variant = bash

[Makefile]
indent_style = tab

[*.md]
trim_trailing_whitespace = false

[*.{cmd,bat}]
end_of_line = crlf
